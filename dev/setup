#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
ROOT="$(dirname "$SCRIPT_DIR")"

ENV_EXAMPLE="$ROOT/.env.example"
ENV_FILE="$ROOT/.env"

# 1) 复制环境变量
if [ ! -f "$ENV_FILE" ]; then
  cp "$ENV_EXAMPLE" "$ENV_FILE"
  echo "已创建 .env（请检查端口和密码配置）"
fi

# 2) 检查 uv 是否已安装
if ! command -v uv &> /dev/null; then
  echo "错误: 未检测到 uv，请先安装: https://docs.astral.sh/uv/getting-started/installation/" >&2
  exit 1
fi

# 默认使用阿里云镜像，可通过 UV_INDEX_URL 覆盖
export UV_INDEX_URL="${UV_INDEX_URL:-https://mirrors.aliyun.com/pypi/simple/}"

# 3) 安装 Python 依赖（uv 按 apps/.python-version 创建 apps/.venv，含 dev 组）
echo "安装 Python 依赖（uv）..."
cd "$ROOT/apps"
uv sync

# 4) 安装前端依赖（使用淘宝镜像加速）
echo "安装前端依赖..."
cd "$ROOT/ui"
npm config set registry https://registry.npmmirror.com
npm install

echo ""
echo "setup 完成！"
echo ""
echo "下一步："
echo "  1. 检查 .env 配置（端口、密码）"
echo "  2. 启动中间件: ./dev/start-docker-compose"
echo "  3. 启动后端:   ./dev/start-api"
echo "  4. 启动前端:   ./dev/start-web"
