#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
ROOT="$(dirname "$SCRIPT_DIR")"

cd "$ROOT/apps"

# 激活虚拟环境（优先 .venv，回退 conda）
if [ -f "$ROOT/.venv/Scripts/activate" ]; then
  source "$ROOT/.venv/Scripts/activate"
elif [ -f "$ROOT/.venv/bin/activate" ]; then
  source "$ROOT/.venv/bin/activate"
elif command -v conda &> /dev/null; then
  eval "$(conda shell.bash hook)"
  conda activate aihelms
else
  echo "错误: 未找到 .venv 虚拟环境且未安装 conda，请先运行 ./dev/setup" >&2
  exit 1
fi

# 清除 Python 字节码缓存，确保加载最新代码
find . -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true

# 开发环境日志目录
export LOG_DIR="$ROOT/logs"
mkdir -p "$LOG_DIR"

PIDS=()
trap 'kill "${PIDS[@]}" 2>/dev/null; wait' EXIT

uvicorn main:app --reload --host 0.0.0.0 --port 8000 &
PIDS+=($!)

# Celery 在 Windows 上 prefork 池（billiard）有 WinError 5 信号量权限问题，开发环境用 solo 池
CELERY_POOL_ARGS=""
if [[ "$(uname -s)" == MINGW* || "$(uname -s)" == MSYS* || "$(uname -s)" == CYGWIN* ]]; then
  CELERY_POOL_ARGS="--pool=solo"
fi

celery -A celery_app worker $CELERY_POOL_ARGS --loglevel=info &
PIDS+=($!)

celery -A celery_app beat --loglevel=info &
PIDS+=($!)

wait
