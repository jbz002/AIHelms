# ============================================================
# AIHelms 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# ------------------------------------------------------------
# PostgreSQL 数据库
# 被 db、litellm、aihelms 三个服务共用
# DB_PORT: 宿主机映射端口（开发中间件用）
# ------------------------------------------------------------
POSTGRES_USER=aihelms
POSTGRES_PASSWORD=aihelms
POSTGRES_DB=aihelms
DB_PORT=5432

# ------------------------------------------------------------
# Redis
# 用于 session 管理、API 限流、缓存
# REDIS_PORT: 宿主机映射端口（开发中间件用）
# ------------------------------------------------------------
REDIS_PASSWORD=aihelms
REDIS_PORT=6379

# ------------------------------------------------------------
# LiteLLM 配置
# master_key: 管理 LiteLLM 的主密钥，用于创建/管理虚拟 key，必须以sk-开头
# salt_key: 用于加密存储在数据库中的模型 API Key
#           首次设置后不可更改，否则已存储的 key 将无法解密
# LITELLM_PORT: 对外展示端口 = openresty 网关入口（外部 AI 客户端连此端口）
# LITELLM_INTERNAL_PORT: litellm 实际监听端口（仅 openresty/aihelms 内部访问，prod 用，dev 不需要）
# AIHELMS_BACKEND_HOST: openresty 网关拉取模型映射的后端地址（仅 dev 中间件用）
#   生产 compose 内置 aihelms（容器名），无需配置
#   dev（WSL2 NAT）host.docker.internal 解析到 WSL2 host 而非 Windows 后端宿主，
#     需填 Windows host IP（WSL2 gateway：`ip route | grep default` 查，如 172.x.x.1）；
#     或 WSL2 切 mirrored 网络模式后用 host.docker.internal
# ------------------------------------------------------------
LITELLM_MASTER_KEY=sk-your-litellm-master-key
# 兼作平台业务 LLM 调用 key（文档接口提取 / Skill 安全审查 / 模型连通性测试），管理员无感
LITELLM_SALT_KEY=your-salt-key-do-not-change-after-set
LITELLM_PORT=4000
# 生产专用：litellm 退让给 openresty 的内部端口（openresty 抢占 LITELLM_PORT 对外）
LITELLM_INTERNAL_PORT=30711
# 平台 LLM 调用在 LiteLLM 的 user 归属标识（发起人无 litellm_user_id 时兜底）
PLATFORM_LLM_USER=aihelms_platform

# ------------------------------------------------------------
# AIHelms 后端
# AIHELMS_VERSION: 镜像版本号
# SECRET_KEY: JWT 签名密钥，用于用户认证 token
# SUPER_ADMIN_PASSWORD: 超级管理员初始密码（首次启动时创建）
# 注：DATABASE_URL、REDIS_URL、LITELLM_URL 由上面的变量自动拼接，无需手动配置
# ------------------------------------------------------------
AIHELMS_VERSION=0.1.19
SECRET_KEY=your_jwt_secret_key_here
SUPER_ADMIN_PASSWORD=admin123

# ------------------------------------------------------------
# AI Hub 统一鉴权(SSO)
# AI_HUB_URL: AI Hub 地址，按环境切换（测试服 http://111.229.103.94:30080）
# AI_HUB_APP_CODE: 应用管理里注册的 app_code
# AI_HUB_ADMIN_ROLE: 拥有此 app_roles 标签的用户 = AIHelms 管理员
# ------------------------------------------------------------
AI_HUB_URL=http://111.229.103.94:30080
AI_HUB_APP_CODE=aihelms
AI_HUB_ADMIN_ROLE=aihelms-admin

# ------------------------------------------------------------
# AI Policies / SkillSpector
# SKILLSPECTOR_VERSION: SkillSpector image version
# AI_POLICIES_TIMEOUT_SECONDS: Skill audit timeout in seconds
# ------------------------------------------------------------
SKILLSPECTOR_VERSION=0.1.0
AI_POLICIES_TIMEOUT_SECONDS=600

# ------------------------------------------------------------
# Crawl4AI 网页抓取
# CRAWL4AI_ENABLED: 是否启用网页抓取功能（false 时 /crawl 接口返回 403）
# CRAWL_TIMEOUT: 单页抓取超时秒数
# ------------------------------------------------------------
CRAWL4AI_ENABLED=true
CRAWL_TIMEOUT=30

# ------------------------------------------------------------
# docs-mcp-server（API文档管理，独立部署，由 docs-mcp-server 项目自管）
# DOCS_MCP_SERVER_URL: REST API 基础地址（不含 /api 前缀，worker 容器）
# ------------------------------------------------------------
DOCS_MCP_SERVER_URL=http://localhost:8080

# docling-serve（文档格式转换：PDF/DOCX/PPTX 等 → Markdown）
DOCLING_SERVE_URL=http://localhost:5001
DOCLING_SERVE_PORT=5001
DOCLING_CONVERT_TIMEOUT=60

# 文档接口调试代理（Try-it-out 后端转发，规避浏览器 CORS）
# DOCUMENT_PROXY_TIMEOUT_SECONDS: 单次转发超时秒数
# DOCUMENT_PROXY_MAX_BYTES: 响应体大小上限（字节），超则截断
DOCUMENT_PROXY_TIMEOUT_SECONDS=15
DOCUMENT_PROXY_MAX_BYTES=1048576

# 成本计算
# USD_TO_CNY_RATE: LiteLLM spend(美元) → 人民币汇率
USD_TO_CNY_RATE=7

# 模型注册表自动更新（后端启动时从官方 LiteLLM cost map 拉取最新快照）
# MODEL_REGISTRY_AUTO_UPDATE: 关闭则只用本地打包快照，不联网
# MODEL_REGISTRY_URL: cost map 地址，逗号分隔多源依次尝试（官方 raw 失败自动切 jsDelivr 镜像）
# MODEL_REGISTRY_FETCH_TIMEOUT: 每源拉取超时秒数（全部失败则降级用本地旧快照，不阻断启动）
# MODEL_REGISTRY_REFRESH_MIN_AGE_HOURS: 本地快照新于该时长则跳过，0=每次启动都拉
MODEL_REGISTRY_AUTO_UPDATE=true
MODEL_REGISTRY_URL=https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json,https://cdn.jsdelivr.net/gh/BerriAI/litellm@main/model_prices_and_context_window.json
MODEL_REGISTRY_FETCH_TIMEOUT=10
MODEL_REGISTRY_REFRESH_MIN_AGE_HOURS=24

# ------------------------------------------------------------
# Gunicorn（生产模式）
# GUNICORN_WORKERS: worker 数量，0=自动（CPU*2+1）
# GUNICORN_TIMEOUT: 请求超时秒数
# GUNICORN_KEEPALIVE: keep-alive 秒数
# GUNICORN_MAX_REQUESTS: worker 处理多少请求后重启（防内存泄漏）
# GUNICORN_MAX_REQUESTS_JITTER: max_requests 随机偏移
# GUNICORN_LOGLEVEL: 日志级别 (debug/info/warning/error)
# ------------------------------------------------------------
GUNICORN_WORKERS=5
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=50
GUNICORN_LOGLEVEL=info

# ------------------------------------------------------------
# Celery Worker
# CELERY_WORKER_CONCURRENCY: 并发数，0=自动（CPU核数）
# CELERY_LOGLEVEL: 日志级别
# CELERY_PREFETCH_MULTIPLIER: 预取任务数
# ------------------------------------------------------------
CELERY_WORKER_CONCURRENCY=5
CELERY_LOGLEVEL=info
CELERY_PREFETCH_MULTIPLIER=1

# ------------------------------------------------------------
# 日志
# LOG_DIR: 日志存储目录，按天轮转，保留30天
#   开发模式: ../logs（相对于 apps/ 目录，即项目根目录下的 logs/）
#   Docker模式: docker-compose.yml 中覆盖为 /logs（容器内路径，映射到 ./logs）
# LOG_LEVEL: 日志级别 (DEBUG/INFO/WARNING/ERROR)
#   开发模式建议 INFO 或 DEBUG，生产默认 WARNING
# ------------------------------------------------------------
LOG_DIR=../logs
LOG_LEVEL=WARNING

# ------------------------------------------------------------
# 文件存储
# DATA_DIR: 数据存储根目录（用户上传的 Skill zip 包、附件、导出文件等）
#   开发模式: ../data（相对于 apps/ 目录，即项目根目录下的 data/）
#   Docker模式: docker-compose.yml 中覆盖为 /data（容器内路径，映射到 ./data）
# 子目录会自动创建：
#   skills/   — Skill zip 包
#   uploads/  — 通用上传文件（图标等）
#   exports/  — 导出文件（日志/报表等）
# ------------------------------------------------------------
DATA_DIR=../data

# ------------------------------------------------------------
# Skill 包物理校验（S5）
# 注册期对 Skill ZIP 做 fail-closed 物理门控（zip slip / 扩展名白名单 / magic bytes / 大小限制）
# SKILLS_PACKAGE_ALLOWED_EXTENSIONS: 留空走模块默认白名单；填入则整体替换（逗号分隔，如 .md,.json,.py）
# ------------------------------------------------------------
SKILLS_PACKAGE_MAX_FILE_SIZE_MB=10
SKILLS_PACKAGE_MAX_TOTAL_SIZE_MB=100
SKILLS_PACKAGE_MAX_FILE_COUNT=500
SKILLS_PACKAGE_ALLOWED_EXTENSIONS=

# ------------------------------------------------------------
# 安全 - 管理员审计日志
# AUDIT_LOG_RETENTION_DAYS: 审计日志保留天数，超过会被定时任务清理
# ------------------------------------------------------------
AUDIT_LOG_RETENTION_DAYS=180

# ------------------------------------------------------------
# 一致性保障（S6）
# IDEMPOTENCY_TTL_HOURS: 幂等键保留时长（小时），同 Idempotency-Key 重复请求返回首次结果
# IDEMPOTENCY_PATH_PREFIXES: 启用幂等的路径前缀（逗号分隔，仅 JSON 写接口）
# STORAGE_COMPENSATION_MAX_RETRIES: 孤儿文件删除补偿最大重试次数
# DISTRIBUTED_LOCK_DEFAULT_TTL: 分布式锁默认 TTL（秒）
# ------------------------------------------------------------
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_PATH_PREFIXES=/api/v1/resource-applications
STORAGE_COMPENSATION_MAX_RETRIES=5
DISTRIBUTED_LOCK_DEFAULT_TTL=30

# ------------------------------------------------------------
# 数据中心 - LLM 调用日志
# LLM_LOG_SYNC_INTERVAL_MINUTES: 从 LiteLLM 增量同步 LLM 日志的间隔（分钟）
# LLM_LOG_RETENTION_DAYS: LLM 日志保留天数，0=不清理
# ------------------------------------------------------------
LLM_LOG_SYNC_INTERVAL_MINUTES=5
LLM_LOG_RETENTION_DAYS=0

# ------------------------------------------------------------
# Nginx 网关
# WEB_PORT: 对外端口（映射到容器内 80）
# NGINX_SERVER_NAME: 访问域名或 IP（用于 Nginx server_name）
#                    多个域名用空格分隔，如 "aihelms.example.com 192.168.1.100"
# NGINX_CLIENT_MAX_BODY_SIZE: 请求体大小限制
# NGINX_PROXY_READ_TIMEOUT: 代理读取超时
# NGINX_PROXY_SEND_TIMEOUT: 代理发送超时
# ------------------------------------------------------------
WEB_PORT=80
NGINX_SERVER_NAME=0.0.0.0
NGINX_WORKER_PROCESSES=auto
NGINX_CLIENT_MAX_BODY_SIZE=100M
NGINX_PROXY_READ_TIMEOUT=300s
NGINX_PROXY_SEND_TIMEOUT=300s

# ------------------------------------------------------------
# Docker 容器日志
# DOCKER_LOG_MAX_SIZE: 单个日志文件大小上限
# DOCKER_LOG_MAX_FILE: 保留的日志文件数量
# ------------------------------------------------------------
DOCKER_LOG_MAX_SIZE=50m
DOCKER_LOG_MAX_FILE=5

# ------------------------------------------------------------
# 时区
# 所有容器统一使用此时区
# ------------------------------------------------------------
TZ=Asia/Shanghai
