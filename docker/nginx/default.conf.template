upstream aihelms_api {
    server aihelms:8000;
}

server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};

    # 安全头（暂不加 X-Frame-Options，web 端后续需被其他系统 iframe 嵌入，改用 CSP frame-ancestors）
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # 屏蔽内部接口（供 openresty 内网拉取映射，公网不可达）
    location ^~ /api/v1/internal/ {
        return 404;
    }

    # API 代理
    location /api {
        proxy_pass http://aihelms_api;
        include /etc/nginx/proxy.conf;
    }

    # MCP streamable HTTP 代理（fastmcp 挂在 /admin-mcp + /web-mcp）
    location /admin-mcp {
        proxy_pass http://aihelms_api;
        include /etc/nginx/proxy.conf;
    }
    location /web-mcp {
        proxy_pass http://aihelms_api;
        include /etc/nginx/proxy.conf;
    }

    # 管理后台
    location = /admin {
        rewrite ^ /admin/ last;
    }
    location /admin/ {
        alias /usr/share/nginx/html/admin/;
        try_files $uri $uri/ /admin/index.html;
    }

    # 平台内置图标
    location /icons/ {
        root /usr/share/nginx/html/web;
        try_files $uri /icons/v1/default.svg;
        add_header Cache-Control "public, max-age=86400";
    }

    # 用户端（默认）
    location / {
        root /usr/share/nginx/html/web;
        try_files $uri $uri/ /index.html;
    }
}
